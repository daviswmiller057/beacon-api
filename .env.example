# Copy this file to .env and replace every required placeholder.
# Never commit the populated .env.

# Required server authentication and integrations.
BEACON_API_KEY=replace-with-a-long-random-secret
NEXTCLOUD_CALDAV_URL=https://nextcloud.example/remote.php/dav
NEXTCLOUD_USERNAME=replace-me
NEXTCLOUD_APP_PASSWORD=replace-me
VIKUNJA_API_URL=http://vikunja.local/api/v1
VIKUNJA_API_TOKEN=replace-me

# Required only when natural-language intake may create a Vikunja task.
VIKUNJA_DEFAULT_PROJECT_ID=

# Core scheduling defaults.
BEACON_TIMEZONE=America/Chicago
BEACON_CALENDARS=theater,school,personal
BEACON_SCHEDULE_CALENDAR=personal
BEACON_INTERACTION_DEFAULT_DURATION_MINUTES=60
BEACON_MAX_DAILY_RANGE_OCCURRENCES=31

# Intent interpreter. Rules mode needs no model credential.
BEACON_INTERPRETER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local runs default to ./data/beacon.db. Compose deliberately overrides this
# with /data/beacon.db on the persistent beacon_data named volume.
CONTEXT_DATABASE_PATH=./data/beacon.db

# Text conversation layer. It reuses GEMINI_API_KEY and the persistent database.
CONVERSATION_ENABLED=false
CONVERSATION_PROVIDER=gemini
CONVERSATION_MODEL=gemini-3.6-flash
CONVERSATION_PROVIDER_TIMEOUT_SECONDS=30
CONVERSATION_PROVIDER_MAX_RETRIES=1
CONVERSATION_MAX_HISTORY_MESSAGES=24
CONVERSATION_MAX_TOOL_ROUNDS=2
CONVERSATION_MAX_SIDE_EFFECT_INTENTS=1
CONVERSATION_MAX_MALFORMED_REPAIRS=1
CONVERSATION_MAX_INPUT_LENGTH=4000
CONVERSATION_MAX_OUTPUT_LENGTH=4000
CONVERSATION_MAX_OUTPUT_TOKENS=1024

# Optional Daily Brief context.
DAILY_BRIEF_TRAVEL_ENABLED=false
DAILY_BRIEF_WEATHER_ENABLED=false
DAILY_BRIEF_TRAVEL_BUFFER_MINUTES=15
BEACON_HOME_LOCATION=
WAZE_REGION=US
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_WEATHER_ENTITY=weather.home
